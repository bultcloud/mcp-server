{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.bultcloud/mcp-server",
  "title": "Bult",
  "description": "Deploy and manage Bult apps from AI coding agents.",
  "websiteUrl": "https://bult.ai",
  "repository": {
    "url": "https://github.com/bultcloud/mcp-server",
    "source": "github"
  },
  "version": "1.0.1",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@bultcloud/mcp-server",
      "version": "1.0.1",
      "transport": {
        "type": "stdio"
      },
      "runtimeHint": "npx",
      "environmentVariables": [
        {
          "name": "BULT_API_URL",
          "description": "Base URL of the Bult.ai API.",
          "isRequired": true,
          "format": "string",
          "isSecret": false,
          "placeholder": "https://app.bult.ai"
        },
        {
          "name": "BULT_API_TOKEN",
          "description": "Bult API token used to authenticate requests.",
          "isRequired": true,
          "format": "string",
          "isSecret": true,
          "placeholder": "your_bult_api_token"
        }
      ]
    }
  ]
}
