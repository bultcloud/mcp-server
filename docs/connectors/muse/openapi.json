    "/projects/{project_id}/deploy": {
      "post": {
        "operationId": "deployProject",
        "summary": "Initiate deployment",
        "x-bult-permission": "write",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Accepted; deployment readiness requires separate verification.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "data": {
                      "type": "null"
                    },
                    "error": {}
                  },
                  "required": []
                }
              }
            }
          },
          "default": {
            "description": "Failure: inspect HTTP status and error. Error body may vary by gateway.",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "commit_message": {
                    "type": "string"
                  },
                  "services": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "commit_message",
                  "services"
                ]
              }
            }
          }
        }
      }
    },
    "/projects/services/{service_id}/logs": {
      "get": {
        "operationId": "getServiceLogs",
        "summary": "Read runtime logs",
        "x-bult-permission": "read",
        "parameters": [
          {
            "name": "service_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Opaque cursor from the previous response."
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "logs": {
                          "type": [
                            "array",
                            "null"
                          ],
                          "items": {
                            "type": "object"
                          }
                        },
                        "cursor": {
                          "type": "string"
                        }
                      },
                      "required": []
                    },
                    "error": {}
                  },
                  "required": []
                }
              }
            }
          },
          "default": {
            "description": "Failure: inspect HTTP status and error. Error body may vary by gateway.",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/projects/services/{service_id}/builds": {
      "get": {
        "operationId": "listBuilds",
        "summary": "Read build history; not full build logs",
        "x-bult-permission": "read",
        "parameters": [
          {
            "name": "service_id",
            "in": "path",
