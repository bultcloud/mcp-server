            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "data": {},
                    "error": {}
                  },
                  "required": []
                }
              }
            }
          },
          "default": {
            "description": "Failure: inspect HTTP status and error. Error body may vary by gateway.",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BultToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Bult API token; no OAuth scope claim."
      }
    },
    "schemas": {
      "Envelope": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "data": {},
          "error": {}
        },
        "required": []
      },
      "ServiceConfig": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "daemon",
              "database"
            ]
          },
          "daemon": {
            "type": "object",
            "properties": {
              "replicas": {
                "type": "integer"
              }
            },
            "required": []
          },
          "database": {
            "type": "object",
            "description": "Database configuration is outside the tested Docker demo."
          },
          "deploy": {
            "type": "object",
            "properties": {
              "box_id": {
                "type": "integer"
              },
              "source_type": {
                "type": "string",
                "enum": [
                  "docker",
                  "git"
                ]
              },
              "image": {
                "type": "string"
              },
              "is_image_private": {
                "type": "boolean"
              },
              "git_url": {
                "type": "string"
              },
              "git_branch": {
                "type": "string"
              },
              "build_type": {
                "type": "string"
              },
              "cmd": {
                "type": "string"
              },
              "entrypoint": {
                "type": "string"
              }
            },
            "required": [
              "box_id",
              "source_type"
            ]
          },
          "ports": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          },
          "envs": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "Potential secrets; exclude from AI context."
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "content": {
                  "type": "string"
                }
              },
              "required": [
                "path",
                "content"
              ]
            }
          }
        },
        "required": [
          "kind",
          "deploy"
        ]
      },
      "ServiceInput": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 63,
            "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$"
          },
          "config": {
            "$ref": "#/components/schemas/ServiceConfig"
          }
        },
        "required": [
          "name",
          "config"
        ]
      },
      "RouteInput": {
        "type": "object",
        "properties": {
          "service_id": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        },
        "required": [
          "service_id",
          "port"
        ]
      }
    }
  }
}
