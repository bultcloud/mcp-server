{
  "openapi": "3.1.0",
  "info": {
    "title": "Bult connector REST API subset",
    "version": "0.1.0",
    "description": "Docker deployment and diagnostics subset derived from Bult MCP and backend source. See verification.md for live coverage. Additional response fields are allowed; not a complete platform contract."
  },
  "servers": [
    {
      "url": "https://app.bult.ai/api/v1"
    }
  ],
  "security": [
    {
      "BultToken": []
    }
  ],
  "paths": {
    "/projects": {
      "get": {
        "operationId": "listProjects",
        "summary": "List accessible projects",
        "x-bult-permission": "read",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "error": {}
                  },
                  "required": []
                }
              }
            }
          },
          "default": {
            "description": "Failure: inspect HTTP status and error. Error body may vary by gateway.",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createProject",
        "summary": "Create a project",
        "x-bult-permission": "write",
        "parameters": [],
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "data": {
                      "type": "string"
                    },
                    "error": {}
                  },
                  "required": []
                }
              }
            }
          },
          "default": {
            "description": "Failure: inspect HTTP status and error. Error body may vary by gateway.",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  }
                },
                "required": [
                  "name"
                ]
              }
            }
          }
        }
      }
    },
    "/projects/{project_id}/overview": {
